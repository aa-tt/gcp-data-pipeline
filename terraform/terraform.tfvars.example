# Example Terraform Variables
# Copy this file to terraform.tfvars and update with your values

project_id  = "datapipeline-480007"
region      = "us-central1"
environment = "dev"

# Storage lifecycle
data_bucket_lifecycle_days = 30

# Dataproc configuration
dataproc_min_instances = 2
dataproc_max_instances = 10

# BigQuery configuration
bigquery_dataset_location = "US"

# Cloud Composer (set to true if you want to enable it - adds ~$300/month)
enable_composer      = false
composer_node_count  = 3
composer_machine_type = "n1-standard-1"

# React UI on Cloud Run (set to false to skip UI deployment)
enable_ui                 = true
ui_allow_unauthenticated  = true  # Set to false for production with authentication

# Cloud Spanner for transaction deduplication (set to true to enable - adds ~$90/month per node)
enable_spanner              = false
spanner_instance_config     = "regional-us-central1"  # Options: regional-us-central1, nam3, nam6
spanner_node_count          = 1                       # 1 node = 2TB storage + 10K QPS
spanner_deletion_protection = true                    # Prevent accidental deletion

# Resource labels
labels = {
  environment = "dev"
  managed_by  = "terraform"
  team        = "data-engineering"
  cost_center = "analytics"
}
